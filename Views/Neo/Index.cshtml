@model List<NeoWatcher.Models.NeoStatViewModel>
@{
    var filter = (NeoWatcher.Models.NeoFilterViewModel)(ViewBag.Filter ?? new NeoWatcher.Models.NeoFilterViewModel());
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>NEO Watcher</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>body{padding:20px}</style>
</head>
<body>
    <h2>NEO Watcher</h2>

    <form method="get" class="mb-4">
        <label>Период с:</label>
        <input type="date" name="from" value="@(filter.From?.ToString("yyyy-MM-dd"))" />
        <label>по:</label>
        <input type="date" name="to" value="@(filter.To?.ToString("yyyy-MM-dd"))" />
        <label class="ms-3">Опасные:</label>
        <input type="checkbox" name="hazardous" value="true" @(filter.Hazardous == true ? "checked" : "") />
        <br />
        <label>Диаметр от:</label>
        <input type="number" step="0.1" name="minDiameter" value="@(filter.MinDiameter)" />
        <label>до:</label>
        <input type="number" step="0.1" name="maxDiameter" value="@(filter.MaxDiameter)" />
        <br />
        <input type="hidden" name="sortBy" value="@filter.SortBy" />
        <input type="hidden" name="sortDir" value="@filter.SortDir" />
        <button type="submit" class="btn btn-primary mt-2">Применить</button>
    </form>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Дата</th>
                <th>Объектов</th>
                <th>Макс. диаметр (м)</th>
                <th>Ср. скорость (км/ч)</th>
                <th>Опасность</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.Date.ToString("yyyy-MM-dd")</td>
                    <td>@row.ObjectCount</td>
                    <td>@row.MaxDiameter.ToString("F1")</td>
                    <td>@row.AvgVelocity.ToString("F0")</td>
                    <td>@(row.HasHazardousObjects ? "✅" : "—")</td>
                </tr>
            }
        </tbody>
    </table>

</body>
</html>
